# Copied to .env by run.sh / run.ps1. .env is git-ignored: nothing in it is ever
# committed or pasted into a chat. Every line is optional on a laptop.

# --- Sign-in -------------------------------------------------------------------
# Local stand-in: a name box on /login (approvers: hemant; Arabic reviewer: layla).
CAP_DEV_REVIEWER_HEADER=true
CAP_ARABIC_REVIEWERS=["layla"]

# Google sign-in: create an OAuth client (type "Web application") in Google Cloud
# console > APIs & Services > Credentials, with this redirect URI:
#   http://localhost:8000/auth/google/callback
# then fill these two lines and map your Google e-mail to your reviewer name.
# CAP_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# CAP_GOOGLE_CLIENT_SECRET=
# CAP_REVIEWER_EMAILS={"you@gmail.com": "hemant", "reviewer@example.com": "layla"}

# --- Models -------------------------------------------------------------------
# mock: no network, the drafter returns the sample episode (default).
# anthropic: real drafts and judges; needs the key. Production reads it from
# Secret Manager; on a laptop it goes here and nowhere else.
CAP_MODEL_BACKEND=mock
# CAP_ANTHROPIC_API_KEY=

# --- Records ------------------------------------------------------------------
CAP_DATA_DIR=cap-data
CAP_PILOT_START=2026-09-08
