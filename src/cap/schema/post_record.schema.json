    "SpotCheck": {
      "additionalProperties": false,
      "description": "D34: one claim chosen at random, shown with its source quote.",
      "properties": {
        "claim_text": {
          "title": "Claim Text",
          "type": "string"
        },
        "reviewer_said_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Said Supported"
        },
        "actually_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actually Supported"
