    },
    "brief": {
      "$ref": "#/$defs/Brief"
    },
    "draft": {
      "$ref": "#/$defs/Draft"
    },
    "human_contribution": {
      "$ref": "#/$defs/HumanContribution"
    },
    "variants": {
