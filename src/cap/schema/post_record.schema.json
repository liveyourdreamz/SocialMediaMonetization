    },
    "asset": {
      "$ref": "#/$defs/Asset"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "publish": {
      "$ref": "#/$defs/Publish"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "flags": {
      "$ref": "#/$defs/Flags"
